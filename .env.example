# KnowledgeGuard — Docker Compose environment
# Copy to .env and fill in real secrets before running: docker compose up
#
# Development defaults are safe to use locally.
# Never use these credentials in production.

# Application
APP_ENV=development
SECRET_KEY=dev-secret-key-not-for-production

# PostgreSQL (managed by Compose)
POSTGRES_DB=knowledgeguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO (managed by Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# OpenAI — required for document Q&A features
OPENAI_API_KEY=sk-...
